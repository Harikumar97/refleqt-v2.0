# Refleqt v2.0 - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL (Supabase or Neon)
DATABASE_URL="postgresql://user:password@host:5432/refleqt?schema=public"

# Neo4j Knowledge Graph (AuraDB Free)
NEO4J_URI="neo4j+s://xxxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-password"

# Redis (Upstash)
REDIS_URL="rediss://default:xxxxx@us1-xxxxx.upstash.io:6379"

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# Anthropic Claude (Primary - for analysis & insights)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# OpenAI (For embeddings & fast filtering)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-xxxxx"

# Google Gemini (For long documents)
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY="AIzaSyxxxxx"

# DeepSeek (For code generation)
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY="sk-xxxxx"

# Perplexity (For web search)
# Get key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY="pplx-xxxxx"

# Grok (For Twitter analysis - requires X Premium+)
# Get key: https://console.x.ai/
GROK_API_KEY="xai-xxxxx"

# ============================================================================
# Authentication (NextAuth.js)
# ============================================================================

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"

# ============================================================================
# Social Media APIs (for Intelligence Feed)
# ============================================================================

# Twitter/X API
TWITTER_API_KEY="xxxxx"
TWITTER_API_SECRET="xxxxx"
TWITTER_BEARER_TOKEN="xxxxx"

# YouTube Data API
YOUTUBE_API_KEY="AIzaSyxxxxx"

# LinkedIn API
LINKEDIN_CLIENT_ID="xxxxx"
LINKEDIN_CLIENT_SECRET="xxxxx"

# Reddit API
REDDIT_CLIENT_ID="xxxxx"
REDDIT_CLIENT_SECRET="xxxxx"

# ============================================================================
# Optional: Monitoring & Error Tracking
# ============================================================================

# Sentry (Error tracking)
SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# ============================================================================
# Development Settings
# ============================================================================

# Node environment
NODE_ENV="development"

# Enable debug logging
DEBUG="false"

# Skip Puppeteer download (for web scraping)
PUPPETEER_SKIP_DOWNLOAD="true"
